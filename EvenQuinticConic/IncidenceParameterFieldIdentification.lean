import EvenQuinticConic.IncidenceDominance
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin

/-!
# Identification of the actual parameter function field

The normalized projective parameter chart is explicitly identified with the
polynomial ring in its two nonpivot coordinates. The geometric matrix-net
hypotheses identify the resulting rational function field with the subfield
generated by the actual Cramer ratios. Evaluation of every parameter polynomial,
and the actual generic matrix, commute with these identifications.
-/

noncomputable section
set_option maxRecDepth 4096

namespace EvenQuinticConic.Incidence

open MvPolynomial Matrix

variable {K : Type*} [Field K]

/-- Dehomogenization factors through the actual relation `T_k = 1`. -/
def incidenceParameterChartToPolynomial (k : Fin 3) :
    ProjectiveCoordinateQuotient (K := K) k →ₐ[K] MvPolynomial (Fin 2) K :=
  Ideal.Quotient.liftₐ _ (dehomogenizeAt k) (by
    intro Q hQ
    have hker : projectiveCoordinateIdeal (K := K) k ≤
        RingHom.ker (dehomogenizeAt k).toRingHom := by
      rw [projectiveCoordinateIdeal, Ideal.span_le]
      intro P hP
      rcases Set.mem_singleton_iff.mp hP with rfl
      simp
    exact RingHom.mem_ker.mp (hker hQ))

@[simp] theorem incidenceParameterChartToPolynomial_mk (k : Fin 3)
    (Q : MvPolynomial (Fin 3) K) :
    incidenceParameterChartToPolynomial k (Ideal.Quotient.mk _ Q) =
      dehomogenizeAt k Q := rfl

/-- This is the actual quotient-chart comparison, with the coordinate map
already used in the geometric parameter projection as its forward map. -/
def incidenceParameterPolynomialChartAlgEquiv (k : Fin 3) :
    MvPolynomial (Fin 2) K ≃ₐ[K] ProjectiveCoordinateQuotient (K := K) k :=
  AlgEquiv.ofAlgHom (incidenceParameterPolynomialChartMap k)
    (incidenceParameterChartToPolynomial k)
    (by
      apply AlgHom.ext
      intro t
      obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective t
      exact incidenceParameterPolynomialChartMap_dehomogenize k Q)
    (by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, incidenceParameterPolynomialChartMap_X,
        AlgHom.id_apply]
      exact (incidenceParameterChartToPolynomial_mk (K := K) k
        (X (k.succAbove i))).trans (dehomogenizeAt_X_succAbove k i))

@[simp] theorem incidenceParameterPolynomialChartAlgEquiv_apply (k : Fin 3)
    (Q : MvPolynomial (Fin 2) K) :
    incidenceParameterPolynomialChartAlgEquiv k Q =
      incidenceParameterPolynomialChartMap k Q := rfl

@[simp] theorem incidenceParameterPolynomialChartAlgEquiv_symm_mk (k : Fin 3)
    (Q : MvPolynomial (Fin 3) K) :
    (incidenceParameterPolynomialChartAlgEquiv k).symm (Ideal.Quotient.mk _ Q) =
      dehomogenizeAt k Q := rfl

theorem incidenceParameterChart_isDomain (k : Fin 3) :
    IsDomain (ProjectiveCoordinateQuotient (K := K) k) :=
  Function.Injective.isDomain
    (incidenceParameterPolynomialChartAlgEquiv (K := K) k).symm.toRingHom
    (incidenceParameterPolynomialChartAlgEquiv (K := K) k).symm.injective

/-- The abstract rational parameter field, retaining the order of the two
nonpivot coordinates. -/
abbrev IncidenceRationalParameterField (K : Type*) [Field K] :=
  FractionRing (MvPolynomial (Fin 2) K)

/-- The quotient chart's fraction field has this explicit two-variable model. -/
def incidenceParameterChartFractionEquiv (k : Fin 3) :
    letI := incidenceParameterChart_isDomain (K := K) k
    FractionRing (ProjectiveCoordinateQuotient (K := K) k) ≃ₐ[K]
      IncidenceRationalParameterField K := by
  letI := incidenceParameterChart_isDomain (K := K) k
  exact IsFractionRing.algEquivOfAlgEquiv
    (incidenceParameterPolynomialChartAlgEquiv (K := K) k).symm

@[simp] theorem incidenceParameterChartFractionEquiv_algebraMap_mk (k : Fin 3)
    (Q : MvPolynomial (Fin 3) K) :
    letI := incidenceParameterChart_isDomain (K := K) k
    incidenceParameterChartFractionEquiv k
      (algebraMap (ProjectiveCoordinateQuotient (K := K) k)
        (FractionRing (ProjectiveCoordinateQuotient (K := K) k))
          (Ideal.Quotient.mk _ Q)) =
      algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K)
        (dehomogenizeAt k Q) := by
  letI := incidenceParameterChart_isDomain (K := K) k
  exact IsFractionRing.algEquivOfAlgEquiv_algebraMap
    (incidenceParameterPolynomialChartAlgEquiv (K := K) k).symm _

/-- The normalized generic parameter over the explicit rational parameter field. -/
def incidenceRationalParameter (k : Fin 3) : Fin 3 → IncidenceRationalParameterField K :=
  chartLift k (fun i => algebraMap (MvPolynomial (Fin 2) K) _ (X i))

@[simp] theorem incidenceRationalParameter_pivot (k : Fin 3) :
    incidenceRationalParameter (K := K) k k = 1 := by
  simp [incidenceRationalParameter]

@[simp] theorem incidenceRationalParameter_succAbove (k : Fin 3) (i : Fin 2) :
    incidenceRationalParameter (K := K) k (k.succAbove i) =
      algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K) (X i) := by
  simp [incidenceRationalParameter]

/-- Every homogeneous-coordinate polynomial is evaluated by dehomogenizing
in the same actual parameter chart and embedding in its fraction field. -/
theorem incidenceRationalParameter_aeval (k : Fin 3) (Q : MvPolynomial (Fin 3) K) :
    aeval (incidenceRationalParameter (K := K) k) Q =
      algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K)
        (dehomogenizeAt k Q) := by
  have hm : aeval (incidenceRationalParameter (K := K) k) =
      (IsScalarTower.toAlgHom K (MvPolynomial (Fin 2) K)
        (IncidenceRationalParameterField K)).comp (dehomogenizeAt k) := by
    ext i
    obtain rfl | ⟨j, rfl⟩ := Fin.eq_self_or_eq_succAbove k i
    · simp
    · simp
  exact AlgHom.congr_fun hm Q

/-- The generic matrix is constructed over the explicit parameter function
field, independently of any chosen spatial chart or Cramer minor. -/
def incidenceRationalGenericMatrix
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) :
    Matrix (Fin 5) (Fin 5) (IncidenceRationalParameterField K) :=
  fun r c => ∑ i, incidenceRationalParameter k i *
    algebraMap K (IncidenceRationalParameterField K) (M i r c)

/-- This matrix is literally the original linear matrix net evaluated at
the normalized rational generic parameter. -/
theorem incidenceRationalGenericMatrix_eq_aeval
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) :
    incidenceRationalGenericMatrix M k =
      (linearMatrixNet M).map (aeval (incidenceRationalParameter (K := K) k)) := by
  ext r c
  simp [incidenceRationalGenericMatrix, linearMatrixNet, Matrix.map_apply, mul_comm]

/-- The actual five-by-five determinant is homogeneous of degree five,
as follows directly from its permutation expansion. -/
theorem linearMatrixNet_det_homogeneous_five
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) :
    (linearMatrixNet M).det.IsHomogeneous 5 := by
  classical
  have hentry (r c : Fin 5) : (linearMatrixNet M r c).IsHomogeneous 1 := by
    apply IsHomogeneous.sum
    intro i _
    exact isHomogeneous_C_mul_X (M i r c) i
  rw [Matrix.det_apply']
  apply IsHomogeneous.sum
  intro s _
  have hp : (∏ i : Fin 5, linearMatrixNet M (s i) i).IsHomogeneous 5 := by
    simpa using IsHomogeneous.prod Finset.univ
      (fun i : Fin 5 => linearMatrixNet M (s i) i) (fun _ => 1)
        (fun i _ => hentry (s i) i)
  simpa only [map_intCast] using hp.C_mul (((Equiv.Perm.sign s : ℤ) : K))

/-- Every parameter chart has a nonsingular actual generic matrix. The
determinant is neither assumed nonzero nor evaluated at a guessed point. -/
theorem incidenceRationalGenericMatrix_det_ne_zero [Infinite K]
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K)
    (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det) (k : Fin 3) :
    (incidenceRationalGenericMatrix M k).det ≠ 0 := by
  have hpoly := linearMatrixNet_det_ne_zero_of_jacobian M hCert.rational_jacobian
  have hdehom := dehomogenizeAt_ne_zero_of_homogeneous k (linearMatrixNet M).det 5
    (linearMatrixNet_det_homogeneous_five M) hpoly
  have he : (incidenceRationalGenericMatrix M k).det =
      algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K)
        (dehomogenizeAt k (linearMatrixNet M).det) := by
    rw [incidenceRationalGenericMatrix_eq_aeval]
    exact ((aeval (R := K) (incidenceRationalParameter (K := K) k)).toRingHom.map_det
      (linearMatrixNet M)).symm.trans (incidenceRationalParameter_aeval k _)
  rw [he]
  intro hz
  apply hdehom
  apply IsFractionRing.injective (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K)
  simpa only [map_zero] using hz

section ActualParameterField

variable [Infinite K] (h2 : (2 : K) ≠ 0)
  (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
  (hbase : ∀ i, M i 0 0 = 0)
  (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det)
  (k : Fin 3) (p : Fin 4)
  (h : (cross (segreChartRow (netLinearRow M) k p)
    (segreChartRow (netQuadraticRow M) k p)).z ≠ 0)

/-- The geometric hypotheses identify the rational parameter field with the
subfield generated by the actual pullback ratios. Algebraic independence is
derived from those hypotheses, not supplied as an additional hypothesis. -/
def incidenceParameterFieldEquiv :
    IncidenceRationalParameterField K ≃ₐ[K] incidenceParameterSubfield M k p h :=
  (incidenceParameterRatios_algebraicIndependent h2 M hM hbase hCert k p h).aevalEquivField

/-- Compatibility with every polynomial in the two retained coordinates. -/
theorem incidenceParameterFieldEquiv_algebraMap_coe (Q : MvPolynomial (Fin 2) K) :
    algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
      (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
        (algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K) Q)) =
      aeval (incidenceParameterRatios M k p h) Q := by
  exact AlgebraicIndependent.aevalEquivField_algebraMap_apply_coe
    (incidenceParameterRatios_algebraicIndependent h2 M hM hbase hCert k p h) Q

/-- The field identification takes the normalized generic vector to the
already constructed actual generic parameter vector, coordinate by coordinate. -/
@[simp] theorem incidenceParameterFieldEquiv_parameter (i : Fin 3) :
    incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
      (incidenceRationalParameter (K := K) k i) =
        incidenceGenericParameter M k p h i := by
  obtain rfl | ⟨j, rfl⟩ := Fin.eq_self_or_eq_succAbove k i
  · simp
  · apply Subtype.ext
    change algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
      (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
        (incidenceRationalParameter k (k.succAbove j))) = _
    rw [incidenceRationalParameter_succAbove,
      incidenceParameterFieldEquiv_algebraMap_coe, aeval_X]
    exact (incidenceGenericParameter_succAbove M k p h j).symm

/-- Evaluation of every polynomial in all three normalized parameter
coordinates commutes with the field identification. -/
theorem incidenceParameterFieldEquiv_aeval (Q : MvPolynomial (Fin 3) K) :
    incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
      (aeval (incidenceRationalParameter (K := K) k) Q) =
        aeval (incidenceGenericParameter M k p h) Q := by
  change (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h).toAlgHom
    (aeval (incidenceRationalParameter (K := K) k) Q) = _
  rw [MvPolynomial.comp_aeval_apply]
  congr 1
  apply MvPolynomial.algHom_ext
  intro i
  simp only [aeval_X]
  exact incidenceParameterFieldEquiv_parameter h2 M hM hbase hCert k p h i

/-- The retained-coordinate polynomial identity already holds inside the
parameter subfield, before embedding in the larger spatial function field. -/
theorem incidenceParameterFieldEquiv_aeval_affine (Q : MvPolynomial (Fin 2) K) :
    incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
      (algebraMap (MvPolynomial (Fin 2) K) (IncidenceRationalParameterField K) Q) =
        aeval (fun i => incidenceGenericParameter M k p h (k.succAbove i)) Q := by
  have he := incidenceParameterFieldEquiv_aeval h2 M hM hbase hCert k p h
    (rename k.succAbove Q)
  rw [incidenceRationalParameter_aeval, dehomogenizeAt_rename_succAbove] at he
  simpa only [aeval_rename, Function.comp_def] using he

/-- In particular, transporting the explicit rational generic matrix gives
the actual matrix over the Cramer-generated parameter subfield. -/
theorem incidenceParameterFieldEquiv_matrix :
    (incidenceRationalGenericMatrix M k).map
      (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h) =
        incidenceGenericMatrix M k p h := by
  ext r c
  simp only [Matrix.map_apply, incidenceRationalGenericMatrix,
    map_sum, map_mul, incidenceParameterFieldEquiv_parameter,
    AlgEquiv.commutes, incidenceGenericMatrix_entry]

/-- Thus the previous generic matrix can be moved back to the explicit
rational parameter field without changing any matrix coefficient. -/
theorem incidenceParameterFieldEquiv_symm_matrix :
    (incidenceGenericMatrix M k p h).map
      (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h).symm =
        incidenceRationalGenericMatrix M k := by
  rw [← incidenceParameterFieldEquiv_matrix h2 M hM hbase hCert k p h]
  ext r c
  exact (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h).symm_apply_apply _

/-- The determinant is transported by the same field isomorphism. -/
theorem incidenceParameterFieldEquiv_det :
    incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
      (incidenceRationalGenericMatrix M k).det =
        (incidenceGenericMatrix M k p h).det := by
  exact ((incidenceParameterFieldEquiv h2 M hM hbase hCert k p h).toRingHom.map_det
    (incidenceRationalGenericMatrix M k)).trans
      (congrArg Matrix.det (incidenceParameterFieldEquiv_matrix h2 M hM hbase hCert k p h))

include h2 hM hbase hCert in
/-- The actual generic matrix over the Cramer-generated subfield is
nonsingular, by the proved identification with the rational parameter field. -/
theorem incidenceGenericMatrix_det_ne_zero :
    (incidenceGenericMatrix M k p h).det ≠ 0 := by
  intro hz
  apply incidenceRationalGenericMatrix_det_ne_zero M hCert k
  apply (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h).injective
  rw [map_zero, incidenceParameterFieldEquiv_det]
  exact hz

/-- The actual parameter quotient chart, rather than just an abstract
two-generator field, has the specified Cramer-generated function field. -/
def incidenceParameterChartFieldEquiv :
    letI := incidenceParameterChart_isDomain (K := K) k
    FractionRing (ProjectiveCoordinateQuotient (K := K) k) ≃ₐ[K]
      incidenceParameterSubfield M k p h := by
  letI := incidenceParameterChart_isDomain (K := K) k
  exact (incidenceParameterChartFractionEquiv (K := K) k).trans
    (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h)

/-- On every element of the actual parameter chart, this field map is the
actual parameter projection followed by the spatial fraction-field embedding. -/
theorem incidenceParameterChartFieldEquiv_algebraMap
    (t : ProjectiveCoordinateQuotient (K := K) k) :
    letI := incidenceParameterChart_isDomain (K := K) k
    algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
      (incidenceParameterChartFieldEquiv h2 M hM hbase hCert k p h
        (algebraMap (ProjectiveCoordinateQuotient (K := K) k)
          (FractionRing (ProjectiveCoordinateQuotient (K := K) k)) t)) =
      incidenceParameterFunctionFieldMap M k p h t := by
  letI := incidenceParameterChart_isDomain (K := K) k
  obtain ⟨Q, rfl⟩ := Ideal.Quotient.mk_surjective t
  change algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
    (incidenceParameterFieldEquiv h2 M hM hbase hCert k p h
      (incidenceParameterChartFractionEquiv k
        (algebraMap (ProjectiveCoordinateQuotient (K := K) k)
          (FractionRing (ProjectiveCoordinateQuotient (K := K) k))
            (Ideal.Quotient.mk _ Q)))) = _
  rw [incidenceParameterChartFractionEquiv_algebraMap_mk,
    incidenceParameterFieldEquiv_algebraMap_coe,
    ← incidenceParameterPolynomialChartMap_dehomogenize k Q]
  exact (AlgHom.congr_fun (incidenceParameterFunctionFieldMap_comp_polynomial M k p h)
    (dehomogenizeAt k Q)).symm

end ActualParameterField

end EvenQuinticConic.Incidence
