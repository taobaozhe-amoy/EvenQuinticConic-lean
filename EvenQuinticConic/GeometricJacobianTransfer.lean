import EvenQuinticConic.ProjectiveJacobianCriterion
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure

/-!
# Jacobian certificates and extension fields

The ideal generated by an equation and all its partial derivatives gives an
algebraic certificate for nonsingularity on nonzero vectors over **every**
field extension. A condition on base-field vectors gives this certificate
here only when the base field is algebraically closed. In particular, this
module never identifies a condition on real vectors with geometric smoothness.
-/

namespace EvenQuinticConic

open MvPolynomial

variable {σ K E : Type*} [Field K] [Field E]

/-- The actual ideal of the equation and all first partial derivatives. -/
def actualJacobianIdeal (F : MvPolynomial σ K) : Ideal (MvPolynomial σ K) :=
  Ideal.span (insert F (Set.range (fun i : σ => pderiv i F)))

/-- Every coordinate belongs to the radical of the actual Jacobian ideal.
For homogeneous equations this excludes projective singularities, including
ones defined only over extension fields. -/
def ProjectiveJacobianCertificate (F : MvPolynomial σ K) : Prop :=
  ∀ i : σ, X i ∈ (actualJacobianIdeal F).radical

theorem self_mem_actualJacobianIdeal (F : MvPolynomial σ K) :
    F ∈ actualJacobianIdeal F :=
  Ideal.subset_span (Set.mem_insert F _)

theorem pderiv_mem_actualJacobianIdeal (F : MvPolynomial σ K) (i : σ) :
    pderiv i F ∈ actualJacobianIdeal F :=
  Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

/-- The certificate applies to arbitrary coefficient embeddings into a field.
No algebraic closure or rational-point density assumption is needed here. -/
theorem ProjectiveJacobianCertificate.eval₂_gradient_nonzero
    {F : MvPolynomial σ K} (hCert : ProjectiveJacobianCertificate F)
    (f : K →+* E) (t : σ → E) (ht : t ≠ 0) (hF : eval₂ f t F = 0) :
    ∃ i : σ, eval₂ f t (pderiv i F) ≠ 0 := by
  classical
  by_contra h
  have hd (i : σ) : eval₂ f t (pderiv i F) = 0 := by
    by_contra hi
    exact h ⟨i, hi⟩
  let φ : MvPolynomial σ K →+* E := eval₂Hom f t
  have hJ : actualJacobianIdeal F ≤ RingHom.ker φ := by
    apply Ideal.span_le.mpr
    intro P hP
    rcases hP with rfl | ⟨i, rfl⟩
    · exact hF
    · exact hd i
  have hrad : (actualJacobianIdeal F).radical ≤ RingHom.ker φ :=
    (RingHom.ker_isPrime φ).radical_le_iff.mpr hJ
  apply ht
  funext i
  have hi := hrad (hCert i)
  change eval₂ f t (X i) = 0 at hi
  simpa using hi

/-- Specialization of the certificate to base-field vectors. -/
theorem ProjectiveJacobianCertificate.rational_jacobian
    {F : MvPolynomial σ K} (hCert : ProjectiveJacobianCertificate F) :
    ∀ t : σ → K, t ≠ 0 → eval t F = 0 →
      ∃ i : σ, eval t (pderiv i F) ≠ 0 := by
  intro t ht hF
  exact hCert.eval₂_gradient_nonzero (RingHom.id K) t ht hF

/-- An algebraically closed extension detects the certificate already over
its coefficient field. This is the descent form of the Nullstellensatz; no
assumption that the coefficient field itself is algebraically closed occurs. -/
theorem projectiveJacobianCertificate_of_algClosed_eval₂_jacobian
    [Finite σ] [IsAlgClosed E] (F : MvPolynomial σ K) (f : K →+* E)
    (hJac : ∀ t : σ → E, t ≠ 0 → eval₂ f t F = 0 →
      ∃ i : σ, eval₂ f t (pderiv i F) ≠ 0) :
    ProjectiveJacobianCertificate F := by
  classical
  letI : Algebra K E := f.toAlgebra
  have hzero (t : σ → E) (ht : t ∈ zeroLocus E (actualJacobianIdeal F)) :
      t = 0 := by
    by_contra ht0
    have hFt : eval₂ f t F = 0 := by
      simpa [aeval_def] using ht F (self_mem_actualJacobianIdeal F)
    obtain ⟨i, hi⟩ := hJac t ht0 hFt
    apply hi
    simpa [aeval_def] using ht (pderiv i F) (pderiv_mem_actualJacobianIdeal F i)
  intro i
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := E) (actualJacobianIdeal F)]
  intro t ht
  simp [hzero t ht]

/-- The certificate is equivalent to the nonzero-vector Jacobian criterion
over any chosen algebraically closed coefficient extension. -/
theorem projectiveJacobianCertificate_iff_algClosed_eval₂_jacobian
    [Finite σ] [IsAlgClosed E] (F : MvPolynomial σ K) (f : K →+* E) :
    ProjectiveJacobianCertificate F ↔
      ∀ t : σ → E, t ≠ 0 → eval₂ f t F = 0 →
        ∃ i : σ, eval₂ f t (pderiv i F) ≠ 0 :=
  ⟨fun h t ht hF => h.eval₂_gradient_nonzero f t ht hF,
    projectiveJacobianCertificate_of_algClosed_eval₂_jacobian F f⟩

/-- In particular, checking vectors over the algebraic closure is precisely
the extension-independent certificate, over any coefficient field. -/
theorem projectiveJacobianCertificate_iff_algebraicClosure_jacobian
    [Finite σ] (F : MvPolynomial σ K) :
    ProjectiveJacobianCertificate F ↔
      ∀ t : σ → AlgebraicClosure K, t ≠ 0 →
        eval₂ (algebraMap K (AlgebraicClosure K)) t F = 0 →
        ∃ i : σ,
          eval₂ (algebraMap K (AlgebraicClosure K)) t (pderiv i F) ≠ 0 :=
  projectiveJacobianCertificate_iff_algClosed_eval₂_jacobian F _

/-- Over an algebraically closed field, the vector Jacobian condition supplies
an actual radical-ideal certificate, by the Nullstellensatz. The algebraic
closure hypothesis is essential to this direction. -/
theorem projectiveJacobianCertificate_of_rational_jacobian
    [Finite σ] [IsAlgClosed K] (F : MvPolynomial σ K)
    (hJac : ∀ t : σ → K, t ≠ 0 → eval t F = 0 →
      ∃ i : σ, eval t (pderiv i F) ≠ 0) :
    ProjectiveJacobianCertificate F := by
  exact projectiveJacobianCertificate_of_algClosed_eval₂_jacobian F
    (RingHom.id K) hJac

/-- Over an algebraically closed base, the certificate and the base-field
nonzero-vector criterion are equivalent. -/
theorem projectiveJacobianCertificate_iff_rational_jacobian
    [Finite σ] [IsAlgClosed K] (F : MvPolynomial σ K) :
    ProjectiveJacobianCertificate F ↔
      ∀ t : σ → K, t ≠ 0 → eval t F = 0 →
        ∃ i : σ, eval t (pderiv i F) ≠ 0 :=
  ⟨fun h => h.rational_jacobian, projectiveJacobianCertificate_of_rational_jacobian F⟩

/-- Under the explicit algebraic-closure hypothesis, the rational-point
criterion transfers to any extension field and any coefficient embedding. -/
theorem eval₂_gradient_nonzero_of_algClosed_rational_jacobian
    [Finite σ] [IsAlgClosed K] (F : MvPolynomial σ K)
    (hJac : ∀ t : σ → K, t ≠ 0 → eval t F = 0 →
      ∃ i : σ, eval t (pderiv i F) ≠ 0)
    (f : K →+* E) (t : σ → E) (ht : t ≠ 0) (hF : eval₂ f t F = 0) :
    ∃ i : σ, eval₂ f t (pderiv i F) ≠ 0 :=
  (projectiveJacobianCertificate_of_rational_jacobian F hJac).eval₂_gradient_nonzero
    f t ht hF

/-- A geometric vector criterion over the algebraic closure transfers to
arbitrary extension fields, even when the coefficient field is not closed. -/
theorem eval₂_gradient_nonzero_of_algebraicClosure_jacobian
    [Finite σ] (F : MvPolynomial σ K)
    (hJac : ∀ t : σ → AlgebraicClosure K, t ≠ 0 →
      eval₂ (algebraMap K (AlgebraicClosure K)) t F = 0 →
      ∃ i : σ,
        eval₂ (algebraMap K (AlgebraicClosure K)) t (pderiv i F) ≠ 0)
    (f : K →+* E) (t : σ → E) (ht : t ≠ 0) (hF : eval₂ f t F = 0) :
    ∃ i : σ, eval₂ f t (pderiv i F) ≠ 0 :=
  ((projectiveJacobianCertificate_iff_algebraicClosure_jacobian F).mpr hJac).eval₂_gradient_nonzero
    f t ht hF

/-- Coefficient extension carries the actual Jacobian ideal to the actual
Jacobian ideal of the extended equation. -/
theorem map_actualJacobianIdeal (F : MvPolynomial σ K) (f : K →+* E) :
    Ideal.map (MvPolynomial.map f) (actualJacobianIdeal F) =
      actualJacobianIdeal (MvPolynomial.map f F) := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    apply Ideal.span_le.mpr
    intro P hP
    change MvPolynomial.map f P ∈ actualJacobianIdeal (MvPolynomial.map f F)
    rcases hP with hP | ⟨i, hi⟩
    · rw [hP]
      exact self_mem_actualJacobianIdeal (MvPolynomial.map f F)
    · rw [← hi, ← pderiv_map]
      exact pderiv_mem_actualJacobianIdeal _ i
  · apply Ideal.span_le.mpr
    intro P hP
    rcases hP with hP | ⟨i, hi⟩
    · rw [hP]
      exact Ideal.mem_map_of_mem _ (self_mem_actualJacobianIdeal F)
    · rw [← hi]
      simpa only [pderiv_map] using
        Ideal.mem_map_of_mem (MvPolynomial.map f) (pderiv_mem_actualJacobianIdeal F i)

/-- The certificate is preserved by any extension of coefficients. -/
theorem ProjectiveJacobianCertificate.map
    {F : MvPolynomial σ K} (hCert : ProjectiveJacobianCertificate F)
    (f : K →+* E) : ProjectiveJacobianCertificate (MvPolynomial.map f F) := by
  intro i
  rw [← map_actualJacobianIdeal F f]
  apply Ideal.map_radical_le
  simpa using Ideal.mem_map_of_mem (MvPolynomial.map f) (hCert i)

end EvenQuinticConic
