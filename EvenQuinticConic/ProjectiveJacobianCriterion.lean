import EvenQuinticConic.ProjectiveJacobianPoints
import EvenQuinticConic.ProjectiveCoordinateSections
import Mathlib.RingTheory.Nullstellensatz

/-!
# Rational and scheme-point Jacobian criteria

Over an algebraically closed field, a Jacobian condition on nonzero vectors
already holds at all points of the actual projective spectrum. The proof
uses the Nullstellensatz for the ideal generated by the equation and its
partial derivatives. Together with the explicit vector-point construction,
this gives the equivalence for homogeneous equations.
-/

namespace EvenQuinticConic

open MvPolynomial TopologicalSpace

variable {K : Type*} [Field K] [IsAlgClosed K]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Nonsingularity at nonzero vectors over the algebraically closed base
field implies gradient nonvanishing at every actual projective prime. -/
theorem projective_gradient_of_rational_jacobian
    (F : PlanePolynomial K)
    (hJac : ∀ v : Fin 3 → K, v ≠ 0 → eval v F = 0 →
      ∃ i : Fin 3, eval v (pderiv i F) ≠ 0) :
    ∀ p : ProjectiveSpectrum (homogeneousSubmodule (Fin 3) K),
      F ∈ p.asHomogeneousIdeal.toIdeal →
        ∃ i : Fin 3, pderiv i F ∉ p.asHomogeneousIdeal.toIdeal := by
  classical
  let J : Ideal (PlanePolynomial K) :=
    Ideal.span (insert F (Set.range (fun i : Fin 3 => pderiv i F)))
  have hFJ : F ∈ J := Ideal.subset_span (Set.mem_insert F _)
  have hdJ (i : Fin 3) : pderiv i F ∈ J :=
    Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
  have hzero (v : Fin 3 → K) (hv : v ∈ zeroLocus K J) : v = 0 := by
    by_contra hv0
    have hFv : eval v F = 0 := by simpa [aeval_def] using hv F hFJ
    obtain ⟨i, hi⟩ := hJac v hv0 hFv
    apply hi
    simpa [aeval_def] using hv (pderiv i F) (hdJ i)
  have hcoordinates (i : Fin 3) : X i ∈ J.radical := by
    rw [← vanishingIdeal_zeroLocus_eq_radical (K := K) J]
    intro v hv
    simp [hzero v hv]
  intro p hFp
  by_contra h
  have hderiv (i : Fin 3) : pderiv i F ∈ p.asHomogeneousIdeal.toIdeal := by
    by_contra hi
    exact h ⟨i, hi⟩
  have hJp : J ≤ p.asHomogeneousIdeal.toIdeal := by
    apply Ideal.span_le.mpr
    intro P hP
    rcases hP with rfl | ⟨i, rfl⟩
    · exact hFp
    · exact hderiv i
  have hrad : J.radical ≤ p.asHomogeneousIdeal.toIdeal :=
    p.isPrime.radical_le_iff.mpr hJp
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp
    (show p ∈ iSup (planeCoordinateOpen K) by
      rw [planeCoordinateOpen_cover]
      trivial)
  exact hi (hrad (hcoordinates i))

/-- For homogeneous equations over an algebraically closed field, the
nonzero-vector and actual projective-prime gradient conditions agree. -/
theorem projective_gradient_iff_rational_jacobian
    (F : PlanePolynomial K) (d : ℕ) (hF : F.IsHomogeneous d) :
    (∀ p : ProjectiveSpectrum (homogeneousSubmodule (Fin 3) K),
      F ∈ p.asHomogeneousIdeal.toIdeal →
        ∃ i : Fin 3, pderiv i F ∉ p.asHomogeneousIdeal.toIdeal) ↔
    (∀ v : Fin 3 → K, v ≠ 0 → eval v F = 0 →
      ∃ i : Fin 3, eval v (pderiv i F) ≠ 0) :=
  ⟨rational_jacobian_of_projective_gradient F d hF,
    projective_gradient_of_rational_jacobian F⟩

end EvenQuinticConic
