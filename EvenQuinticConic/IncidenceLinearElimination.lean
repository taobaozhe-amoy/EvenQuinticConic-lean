import EvenQuinticConic.IncidenceGenericFiber
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Actual elimination of one affine incidence coordinate

The substitution solves a displayed affine linear equation. Its evaluation
identities hold over every field extension. The kernel computation below
uses the actual principal ideal generated by that equation.
-/

noncomputable section
namespace EvenQuinticConic.Incidence
open MvPolynomial

variable {F : Type*} [Field F] {n : ℕ}

/-- The affine linear equation with the indicated coefficients. -/
def affineLinearPolynomial (a : Fin (n + 1) → F) (c : F) :
    MvPolynomial (Fin (n + 1)) F :=
  (∑ i, C (a i) * X i) + C c

/-- The expression for the eliminated coordinate. -/
def affineEliminatedCoordinate (a : Fin (n + 1) → F) (c : F)
    (q : Fin (n + 1)) : MvPolynomial (Fin n) F :=
  C (-(a q)⁻¹) * ((∑ j, C (a (q.succAbove j)) * X j) + C c)

/-- Substitute the solved coordinate, retaining the other coordinates in order. -/
def affineEliminationSubstitution (a : Fin (n + 1) → F) (c : F)
    (q : Fin (n + 1)) :
    MvPolynomial (Fin (n + 1)) F →ₐ[F] MvPolynomial (Fin n) F :=
  aeval (Fin.insertNth q (affineEliminatedCoordinate a c q) X)

@[simp] theorem affineEliminationSubstitution_C
    (a : Fin (n + 1) → F) (c d : F) (q : Fin (n + 1)) :
    affineEliminationSubstitution a c q (C d) = C d := by
  simp [affineEliminationSubstitution]

@[simp] theorem affineEliminationSubstitution_X_pivot
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) :
    affineEliminationSubstitution a c q (X q) = affineEliminatedCoordinate a c q := by
  simp [affineEliminationSubstitution]

@[simp] theorem affineEliminationSubstitution_X_succAbove
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (j : Fin n) :
    affineEliminationSubstitution a c q (X (q.succAbove j)) = X j := by
  simp [affineEliminationSubstitution]

/-- The substitution sends its defining affine linear equation to zero. -/
theorem affineEliminationSubstitution_linear
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0) :
    affineEliminationSubstitution a c q (affineLinearPolynomial a c) = 0 := by
  simp only [affineLinearPolynomial, map_add, map_sum, map_mul, affineEliminationSubstitution_C]
  rw [Fin.sum_univ_succAbove _ q]
  simp only [affineEliminationSubstitution_X_pivot,
    affineEliminationSubstitution_X_succAbove, affineEliminatedCoordinate]
  have hm : C (a q) * C (-(a q)⁻¹) = (-1 : MvPolynomial (Fin n) F) := by
    rw [← C_mul]
    simp [ha]
  rw [← mul_assoc, hm]
  ring

/-- Restoring the retained coordinates expresses the eliminated-coordinate
error as a unit multiple of the original affine equation. -/
theorem affineEliminationSubstitution_pivot_difference
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0) :
    X q - rename q.succAbove (affineEliminatedCoordinate a c q) =
      C ((a q)⁻¹) * affineLinearPolynomial a c := by
  have hC : C ((a q)⁻¹) * C (a q) = (1 : MvPolynomial (Fin (n + 1)) F) := by
    change C ((a q)⁻¹) * C (a q) = _
    rw [← C_mul]
    simp [ha]
  simp only [affineEliminatedCoordinate, map_mul, rename_C, map_add, map_sum,
    rename_X, map_neg]
  rw [affineLinearPolynomial, Fin.sum_univ_succAbove _ q]
  calc
    _ = C ((a q)⁻¹) * C (a q) * X q +
        C ((a q)⁻¹) * ((∑ j, C (a (q.succAbove j)) * X (q.succAbove j)) + C c) := by
      rw [hC]
      ring
    _ = _ := by ring

/-- Every polynomial differs from its eliminated substitution by a multiple
of the displayed affine linear equation. -/
theorem affineLinearPolynomial_dvd_sub_elimination
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0)
    (P : MvPolynomial (Fin (n + 1)) F) :
    affineLinearPolynomial a c ∣
      P - rename q.succAbove (affineEliminationSubstitution a c q P) := by
  have hX : ∀ i : Fin (n + 1), affineLinearPolynomial a c ∣
      X i - rename q.succAbove (affineEliminationSubstitution a c q (X i)) := by
    intro i
    induction i using Fin.succAboveCases q with
    | x =>
      rw [affineEliminationSubstitution_X_pivot,
        affineEliminationSubstitution_pivot_difference a c q ha]
      exact dvd_mul_left _ _
    | p j => simp
  induction P using MvPolynomial.induction_on with
  | C d => simp
  | add P Q hP hQ =>
    simpa only [map_add, add_sub_add_comm] using dvd_add hP hQ
  | mul_X P i hP =>
    simp only [map_mul]
    have heq : P * X i -
        rename q.succAbove (affineEliminationSubstitution a c q P) *
          rename q.succAbove (affineEliminationSubstitution a c q (X i)) =
        (P - rename q.succAbove (affineEliminationSubstitution a c q P)) * X i +
          rename q.succAbove (affineEliminationSubstitution a c q P) *
          (X i - rename q.succAbove (affineEliminationSubstitution a c q (X i))) := by ring
    rw [heq]
    exact dvd_add (dvd_mul_of_dvd_left hP _) (dvd_mul_of_dvd_right (hX i) _)

/-- The only polynomials annihilated by affine elimination are multiples of
its actual defining linear equation. -/
theorem affineEliminationSubstitution_eq_zero_iff_dvd
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0)
    (P : MvPolynomial (Fin (n + 1)) F) :
    affineEliminationSubstitution a c q P = 0 ↔ affineLinearPolynomial a c ∣ P := by
  constructor
  · intro hP
    simpa [hP] using affineLinearPolynomial_dvd_sub_elimination a c q ha P
  · rintro ⟨Q, rfl⟩
    rw [map_mul, affineEliminationSubstitution_linear a c q ha, zero_mul]

section Extension
variable {L : Type*} [Field L] [Algebra F L]

/-- Solving the actual affine relation gives the evaluation of the substituted
coordinate, including its scalar-extension coefficients. -/
theorem aeval_affineEliminatedCoordinate
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0)
    (x : Fin (n + 1) → L)
    (hlinear : (∑ i, algebraMap F L (a i) * x i) + algebraMap F L c = 0) :
    aeval (fun j => x (q.succAbove j)) (affineEliminatedCoordinate a c q) = x q := by
  have ha' : algebraMap F L (a q) ≠ 0 := (map_ne_zero (algebraMap F L)).mpr ha
  rw [Fin.sum_univ_succAbove _ q] at hlinear
  simp only [affineEliminatedCoordinate, map_mul, aeval_C, map_neg, map_inv₀,
    map_add, map_sum, aeval_X]
  apply (mul_left_cancel₀ ha')
  calc
    algebraMap F L (a q) *
        (- (algebraMap F L (a q))⁻¹ *
          ((∑ j, algebraMap F L (a (q.succAbove j)) * x (q.succAbove j)) +
            algebraMap F L c)) =
        - ((∑ j, algebraMap F L (a (q.succAbove j)) * x (q.succAbove j)) +
            algebraMap F L c) := by field_simp
    _ = algebraMap F L (a q) * x q := by linear_combination -hlinear

/-- The eliminated polynomial has exactly the original value on the affine
linear locus, over any field extension. -/
theorem aeval_affineEliminationSubstitution
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0)
    (x : Fin (n + 1) → L)
    (hlinear : (∑ i, algebraMap F L (a i) * x i) + algebraMap F L c = 0)
    (P : MvPolynomial (Fin (n + 1)) F) :
    aeval (fun j => x (q.succAbove j)) (affineEliminationSubstitution a c q P) =
      aeval x P := by
  have h : (aeval (fun j => x (q.succAbove j))).comp
      (affineEliminationSubstitution a c q) = aeval x := by
    ext i
    induction i using Fin.succAboveCases q with
    | x => simpa using aeval_affineEliminatedCoordinate a c q ha x hlinear
    | p j => simp
  exact congrArg (fun f : MvPolynomial (Fin (n + 1)) F →ₐ[F] L => f P) h

/-- A genuine second equation produces the displayed relation among the
retained coordinates; nonvanishing of that polynomial is proved separately. -/
theorem aeval_affineEliminationSubstitution_eq_zero
    (a : Fin (n + 1) → F) (c : F) (q : Fin (n + 1)) (ha : a q ≠ 0)
    (x : Fin (n + 1) → L)
    (hlinear : (∑ i, algebraMap F L (a i) * x i) + algebraMap F L c = 0)
    (P : MvPolynomial (Fin (n + 1)) F) (hP : aeval x P = 0) :
    aeval (fun j => x (q.succAbove j)) (affineEliminationSubstitution a c q P) = 0 := by
  rw [aeval_affineEliminationSubstitution a c q ha x hlinear P, hP]

end Extension

/-- Normalize a homogeneous linear equation in an actual nonzero coordinate. -/
theorem chartCoordinates_linear_relation
    (a : Fin (n + 2) → F) (p : Fin (n + 2)) (y : Fin (n + 2) → F)
    (hp : y p ≠ 0) (hlinear : (∑ i, a i * y i) = 0) :
    (∑ j, a (p.succAbove j) * chartCoordinates p y j) + a p = 0 := by
  rw [Fin.sum_univ_succAbove _ p] at hlinear
  simp only [chartCoordinates]
  apply (mul_right_cancel₀ hp)
  rw [add_mul, Finset.sum_mul, zero_mul]
  simp only [mul_assoc, div_mul_cancel₀ _ hp]
  linear_combination hlinear

/-- A nonzero value on the homogeneous linear locus, in the chosen chart,
forces the actual residual affine polynomial to be nonzero. No independence
or dominance statement is an input. -/
theorem affineElimination_dehomogenize_ne_zero_of_witness
    (a : Fin (n + 2) → F) (p : Fin (n + 2)) (q : Fin (n + 1))
    (ha : a (p.succAbove q) ≠ 0)
    (P : MvPolynomial (Fin (n + 2)) F) (d : ℕ) (hP : P.IsHomogeneous d)
    (y : Fin (n + 2) → F) (hp : y p ≠ 0)
    (hlinear : (∑ i, a i * y i) = 0) (hy : eval y P ≠ 0) :
    affineEliminationSubstitution (fun j => a (p.succAbove j)) (a p) q
      (dehomogenizeAt p P) ≠ 0 := by
  have hl := chartCoordinates_linear_relation a p y hp hlinear
  have he := aeval_affineEliminationSubstitution
    (fun j => a (p.succAbove j)) (a p) q ha (chartCoordinates p y)
    (by simpa using hl) (dehomogenizeAt p P)
  have hn := eval_dehomogenizeAt_ne_zero p y hp P d hP hy
  intro hz
  rw [hz, map_zero] at he
  apply hn
  exact he.symm

/-- The actual symmetric five-variable quadratic and its nonzero adjugate
force a nonzero residual polynomial after solving any nonzero affine polar
coefficient. In particular, the nonzero polynomial needed for the generic
fiber dimension argument is a conclusion, not an extra input. -/
theorem affineElimination_incidenceQuadratic_ne_zero [Infinite F]
    (h2 : (2 : F) ≠ 0) (A : Matrix (Fin 5) (Fin 5) F)
    (hA : A.IsSymm) (hbase : A 0 0 = 0) (hadj : A.adjugate ≠ 0)
    (p : Fin 4) (q : Fin 3) (ha : A (p.succAbove q).succ 0 ≠ 0) :
    affineEliminationSubstitution (fun j => A (p.succAbove j).succ 0)
      (A p.succ 0) q
      (dehomogenizeAt p (matrixQuadraticPolynomial (A.submatrix Fin.succ Fin.succ))) ≠ 0 := by
  obtain ⟨y, hp, hl, hy⟩ := exists_polar_zero_quadratic_ne_zero_of_adjugate
    h2 A hA hbase (p.succAbove q) p (Fin.succAbove_ne p q).symm ha hadj
  exact affineElimination_dehomogenize_ne_zero_of_witness
    (fun i => A i.succ 0) p q ha _ 2 (matrixQuadraticPolynomial_homogeneous _) y hp hl hy

end EvenQuinticConic.Incidence
