import EvenQuinticConic.Incidence
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.AlgebraicGeometry.AffineScheme
import Mathlib.Tactic.FinCases

/-!
# The actual affine algebra of the open-minor incidence chart

The two normalized incidence equations define a quotient of a polynomial
ring in two variables. If the first two-column minor is invertible, explicit
elimination identifies this quotient, as an algebra, with the coefficient
ring. Applying `Spec` gives an actual scheme isomorphism. Specializing the
coefficient ring to its localization at the minor gives the usual open-minor
chart without a field or nonzero-minor hypothesis.

These are affine scheme statements. Identifying this affine scheme with the
appropriate open of a global projective incidence scheme, and proving that
the open is nonempty or dense, are separate tasks.
-/

noncomputable section

open MvPolynomial AlgebraicGeometry CategoryTheory

namespace EvenQuinticConic.Incidence

variable {R : Type*} [CommRing R]

/-- Change the coefficient ring of a row of incidence coefficients. -/
def mapRow {S : Type*} [CommRing S] (f : R →+* S) (a : Vec3 R) : Vec3 S :=
  ⟨f a.x, f a.y, f a.z⟩

@[simp]
theorem mapRow_cross {S : Type*} [CommRing S] (f : R →+* S) (a b : Vec3 R) :
    mapRow f (cross a b) = cross (mapRow f a) (mapRow f b) := by
  ext <;> simp [mapRow, cross]

/-- The first affine incidence equation after setting the third coordinate to one. -/
def rowPolynomial (a : Vec3 R) : MvPolynomial (Fin 2) R :=
  C a.x * X 0 + C a.y * X 1 + C a.z

/-- The actual ideal generated by the two normalized incidence equations. -/
def affineIncidenceIdeal (a b : Vec3 R) : Ideal (MvPolynomial (Fin 2) R) :=
  Ideal.span {rowPolynomial a, rowPolynomial b}

/-- The coordinate ring defined by the two equations; no isomorphism is part of the data. -/
abbrev AffineIncidenceAlgebra (a b : Vec3 R) :=
  MvPolynomial (Fin 2) R ⧸ affineIncidenceIdeal a b

/-- Explicit normalized coordinates, using a specified inverse of the minor. -/
def inverseMinorPoint (a b : Vec3 R) (δ : R) : Vec3 R :=
  ⟨(cross a b).x * δ, (cross a b).y * δ, 1⟩

theorem inverseMinorPoint_isIncident (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) :
    IsIncident a b (inverseMinorPoint a b δ) := by
  dsimp [IsIncident, dot, inverseMinorPoint, cross] at *
  constructor
  · linear_combination -a.z * hδ
  · linear_combination -b.z * hδ

/-- Elimination is valid over any commutative ring once the minor is inverted. -/
theorem inverseMinorPoint_unique (a b t : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) (ht : IsIncident a b t) (hz : t.z = 1) :
    t = inverseMinorPoint a b δ := by
  obtain ⟨hx, hy⟩ := incident_minor_identities a b t ht
  rw [hz, mul_one] at hx hy
  apply Vec3.ext
  · change t.x = (cross a b).x * δ
    calc
      t.x = ((cross a b).z * δ) * t.x := by rw [hδ, one_mul]
      _ = ((cross a b).z * t.x) * δ := by ring
      _ = (cross a b).x * δ := by rw [hx]
  · change t.y = (cross a b).y * δ
    calc
      t.y = ((cross a b).z * δ) * t.y := by rw [hδ, one_mul]
      _ = ((cross a b).z * t.y) * δ := by ring
      _ = (cross a b).y * δ := by rw [hy]
  · exact hz

/-- Evaluation at the explicit solution in the coefficient ring. -/
def affineIncidenceEval (a b : Vec3 R) (δ : R) :
    MvPolynomial (Fin 2) R →ₐ[R] R :=
  aeval ![(cross a b).x * δ, (cross a b).y * δ]

theorem affineIncidenceIdeal_le_ker (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) :
    affineIncidenceIdeal a b ≤ RingHom.ker (affineIncidenceEval a b δ).toRingHom := by
  rw [affineIncidenceIdeal, Ideal.span_le]
  intro p hp
  rcases Set.mem_insert_iff.mp hp with rfl | hp
  · have h := (inverseMinorPoint_isIncident a b δ hδ).1
    simpa [RingHom.mem_ker, affineIncidenceEval, rowPolynomial,
      dot, inverseMinorPoint] using h
  · have hp' : p = rowPolynomial b := Set.mem_singleton_iff.mp hp
    subst p
    have h := (inverseMinorPoint_isIncident a b δ hδ).2
    simpa [RingHom.mem_ker, affineIncidenceEval, rowPolynomial,
      dot, inverseMinorPoint] using h

/-- The explicit evaluation descends to the quotient by the actual equations. -/
def affineIncidenceToBase (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) : AffineIncidenceAlgebra a b →ₐ[R] R :=
  Ideal.Quotient.liftₐ (affineIncidenceIdeal a b) (affineIncidenceEval a b δ)
    (fun _ hp => affineIncidenceIdeal_le_ker a b δ hδ hp)

@[simp]
theorem affineIncidenceToBase_mk (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) (p : MvPolynomial (Fin 2) R) :
    affineIncidenceToBase a b δ hδ (Ideal.Quotient.mk _ p) =
      affineIncidenceEval a b δ p := rfl

/-- The universal quotient coordinates satisfy the two incidence equations. -/
theorem affineIncidence_universal_isIncident (a b : Vec3 R) :
    IsIncident
      (mapRow (algebraMap R (AffineIncidenceAlgebra a b)) a)
      (mapRow (algebraMap R (AffineIncidenceAlgebra a b)) b)
      ⟨Ideal.Quotient.mk _ (X 0), Ideal.Quotient.mk _ (X 1), 1⟩ := by
  have hrow (c : Vec3 R) (hc : rowPolynomial c ∈ affineIncidenceIdeal a b) :
      dot (mapRow (algebraMap R (AffineIncidenceAlgebra a b)) c)
        ⟨Ideal.Quotient.mk _ (X 0), Ideal.Quotient.mk _ (X 1), 1⟩ = 0 := by
    have hz := (Ideal.Quotient.eq_zero_iff_mem).mpr hc
    simpa [rowPolynomial, dot, mapRow, map_add, map_mul,
      Ideal.Quotient.algebraMap_eq] using hz
  exact ⟨hrow a (Ideal.subset_span (by simp)),
    hrow b (Ideal.subset_span (by simp))⟩

/-- The universal quotient coordinates are the explicit constants given by elimination. -/
theorem affineIncidence_coordinate_eq (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) (i : Fin 2) :
    Ideal.Quotient.mk (affineIncidenceIdeal a b) (X i) =
      algebraMap R (AffineIncidenceAlgebra a b)
        (![(cross a b).x * δ, (cross a b).y * δ] i) := by
  let f := algebraMap R (AffineIncidenceAlgebra a b)
  have hd : (cross (mapRow f a) (mapRow f b)).z * f δ = 1 := by
    simpa [mapRow, cross, ← map_mul, ← map_sub] using congrArg f hδ
  have hu := inverseMinorPoint_unique (mapRow f a) (mapRow f b)
    ⟨Ideal.Quotient.mk _ (X 0), Ideal.Quotient.mk _ (X 1), 1⟩ (f δ) hd
    (affineIncidence_universal_isIncident a b) rfl
  fin_cases i
  · have hx := congrArg Vec3.x hu
    simpa [inverseMinorPoint, cross, mapRow, f, map_mul, map_sub] using hx
  · have hy := congrArg Vec3.y hu
    simpa [inverseMinorPoint, cross, mapRow, f, map_mul, map_sub] using hy

/-- Evaluation followed by constants is the identity on the actual quotient algebra. -/
theorem affineIncidence_base_comp_eval (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) :
    (Algebra.ofId R (AffineIncidenceAlgebra a b)).comp
      (affineIncidenceToBase a b δ hδ) = AlgHom.id R (AffineIncidenceAlgebra a b) := by
  apply Ideal.Quotient.algHom_ext
  ext i
  simpa [affineIncidenceEval] using (affineIncidence_coordinate_eq a b δ hδ i).symm

/-- Actual coordinate-algebra isomorphism, with both inverse identities proved. -/
def affineIncidenceAlgEquiv (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) : AffineIncidenceAlgebra a b ≃ₐ[R] R where
  toFun := affineIncidenceToBase a b δ hδ
  invFun := algebraMap R (AffineIncidenceAlgebra a b)
  left_inv x := AlgHom.congr_fun (affineIncidence_base_comp_eval a b δ hδ) x
  right_inv r := (affineIncidenceToBase a b δ hδ).commutes r
  map_mul' := (affineIncidenceToBase a b δ hδ).map_mul
  map_add' := (affineIncidenceToBase a b δ hδ).map_add
  commutes' := (affineIncidenceToBase a b δ hδ).commutes

@[simp]
theorem affineIncidenceAlgEquiv_mk (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) (p : MvPolynomial (Fin 2) R) :
    affineIncidenceAlgEquiv a b δ hδ (Ideal.Quotient.mk _ p) =
      aeval ![(cross a b).x * δ, (cross a b).y * δ] p := rfl

@[simp]
theorem affineIncidenceAlgEquiv_symm_apply (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) (r : R) :
    (affineIncidenceAlgEquiv a b δ hδ).symm r =
      algebraMap R (AffineIncidenceAlgebra a b) r := rfl

/-- The scheme cut out by the two equations is isomorphic to its affine base. -/
def affineIncidenceSchemeIso (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) :
    Spec (CommRingCat.of (AffineIncidenceAlgebra a b)) ≅ Spec (CommRingCat.of R) :=
  Scheme.Spec.mapIso (affineIncidenceAlgEquiv a b δ hδ).toRingEquiv.symm.toCommRingCatIso.op

/-- The constructed scheme isomorphism is the original projection to the base. -/
@[simp]
theorem affineIncidenceSchemeIso_hom (a b : Vec3 R) (δ : R)
    (hδ : (cross a b).z * δ = 1) :
    (affineIncidenceSchemeIso a b δ hδ).hom =
      Spec.map (CommRingCat.ofHom (algebraMap R (AffineIncidenceAlgebra a b))) := rfl

/-- The coefficient row over the basic-open coordinate ring where the minor is inverted. -/
def localizedRow (a b c : Vec3 R) : Vec3 (Localization.Away (cross a b).z) :=
  mapRow (algebraMap R (Localization.Away (cross a b).z)) c

/-- Explicit localized coordinate-algebra isomorphism on the open-minor chart. -/
def localizedIncidenceAlgEquiv (a b : Vec3 R) :
    AffineIncidenceAlgebra (localizedRow a b a) (localizedRow a b b)
      ≃ₐ[Localization.Away (cross a b).z] Localization.Away (cross a b).z :=
  affineIncidenceAlgEquiv (localizedRow a b a) (localizedRow a b b)
    (IsLocalization.Away.invSelf (S := Localization.Away (cross a b).z) (cross a b).z)
    (by simpa [localizedRow, mapRow, cross, map_sub, map_mul] using
      IsLocalization.Away.mul_invSelf (S := Localization.Away (cross a b).z) (cross a b).z)

/-- Actual scheme isomorphism over the localization at the chosen minor. -/
def localizedIncidenceSchemeIso (a b : Vec3 R) :
    Spec (CommRingCat.of
      (AffineIncidenceAlgebra (localizedRow a b a) (localizedRow a b b))) ≅
      Spec (CommRingCat.of (Localization.Away (cross a b).z)) :=
  Scheme.Spec.mapIso (localizedIncidenceAlgEquiv a b).toRingEquiv.symm.toCommRingCatIso.op

/-- The localization spectrum is the actual basic open in the coefficient spectrum. -/
def minorBasicOpenIso (S : CommRingCat) (a b : Vec3 S) :
    Scheme.Opens.toScheme (X := Spec S)
      (PrimeSpectrum.basicOpen (cross a b).z) ≅
      Spec (CommRingCat.of (Localization.Away (cross a b).z)) :=
  let e : Localization.Away (cross a b).z ≃ₐ[S]
      Γ(Spec S, PrimeSpectrum.basicOpen (cross a b).z) :=
    IsLocalization.algEquiv (Submonoid.powers (cross a b).z) _ _
  (IsAffineOpen.Spec_basicOpen (R := S) (cross a b).z).isoSpec ≪≫
    Scheme.Spec.mapIso e.toRingEquiv.toCommRingCatIso.op

/-- The normalized incidence scheme over the localization is the base's actual basic open. -/
def localizedIncidenceBasicOpenIso (a b : Vec3 R) :
    Spec (CommRingCat.of
      (AffineIncidenceAlgebra (localizedRow a b a) (localizedRow a b b))) ≅
      Scheme.Opens.toScheme (X := Spec (CommRingCat.of R))
        (PrimeSpectrum.basicOpen (cross a b).z) :=
  localizedIncidenceSchemeIso a b ≪≫ (minorBasicOpenIso (CommRingCat.of R) a b).symm

/-- A field-valued evaluation where the minor is nonzero gives an actual point
of the minor basic open. This separates nonemptiness from the chart construction. -/
theorem minorBasicOpen_nonempty_of_eval {K : Type*} [Field K]
    (f : R →+* K) (a b : Vec3 R) (h : f (cross a b).z ≠ 0) :
    Nonempty (PrimeSpectrum.basicOpen (cross a b).z :
      (Spec (CommRingCat.of R)).Opens) := by
  let p : PrimeSpectrum R := PrimeSpectrum.comap f ⟨⊥, Ideal.bot_prime⟩
  refine ⟨⟨p, ?_⟩⟩
  change f (cross a b).z ∉ (⊥ : Ideal K)
  simpa using h

/-- Nonvanishing of a minor under a field-valued evaluation makes the actual
localized incidence scheme nonempty, via the constructed scheme isomorphism. -/
theorem localizedIncidenceScheme_nonempty_of_eval {K : Type*} [Field K]
    (f : R →+* K) (a b : Vec3 R) (h : f (cross a b).z ≠ 0) :
    Nonempty (Spec (CommRingCat.of
      (AffineIncidenceAlgebra (localizedRow a b a) (localizedRow a b b)))) := by
  obtain ⟨p⟩ := minorBasicOpen_nonempty_of_eval f a b h
  exact ⟨(localizedIncidenceBasicOpenIso a b).inv.base p⟩

end EvenQuinticConic.Incidence
