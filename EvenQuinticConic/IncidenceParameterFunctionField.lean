import EvenQuinticConic.IncidenceParameterProjection
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.AlgebraicIndependent.Basic

/-!
# Actual parameter ratios in the incidence function field

The two parameter ratios are the pullbacks of the actual first-factor
coordinates, embedded into the rational function field in three spatial
variables. Their generated intermediate field contains the normalized
parameter vector. Both incidence equations are verified at the generic
spatial point; none of these relations is an input.
-/

noncomputable section
namespace EvenQuinticConic.Incidence
open MvPolynomial

variable {K : Type*} [Field K]

abbrev IncidenceSpatialFunctionField (K : Type*) [Field K] :=
  FractionRing (MvPolynomial (Fin 3) K)

/-- The genuine parameter-chart pullback into the spatial function field. -/
def incidenceParameterFunctionFieldMap
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    ProjectiveCoordinateQuotient (K := K) k →ₐ[K] IncidenceSpatialFunctionField K :=
  ((minorLocalizationToFractionField _ _ h).restrictScalars K).comp
    (incidenceParameterCramerMap M k p)

/-- The actual two parameter ratios in the function field. -/
def incidenceParameterRatios
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) (i : Fin 2) :
    IncidenceSpatialFunctionField K :=
  incidenceParameterFunctionFieldMap M k p h (Ideal.Quotient.mk _ (X (k.succAbove i)))

/-- The subfield generated by the actual parameter ratios. -/
def incidenceParameterSubfield
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    IntermediateField K (IncidenceSpatialFunctionField K) :=
  IntermediateField.adjoin K (Set.range (incidenceParameterRatios M k p h))

/-- The normalized parameter vector is already defined over its generated
intermediate field, rather than only over the larger spatial field. -/
def incidenceGenericParameter
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    Fin 3 → incidenceParameterSubfield M k p h :=
  Fin.insertNth k 1 (fun i => ⟨incidenceParameterRatios M k p h i,
    IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩)

@[simp] theorem incidenceGenericParameter_pivot
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    incidenceGenericParameter M k p h k = 1 := by simp [incidenceGenericParameter]

@[simp] theorem incidenceGenericParameter_succAbove
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) (i : Fin 2) :
    algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
      (incidenceGenericParameter M k p h (k.succAbove i)) =
        incidenceParameterRatios M k p h i := by simp [incidenceGenericParameter]

/-- The three independent spatial affine coordinates. -/
def incidenceGenericSpatialAffine (K : Type*) [Field K] :
    Fin 3 → IncidenceSpatialFunctionField K :=
  fun i => algebraMap (MvPolynomial (Fin 3) K) _ (X i)

/-- Their actual homogeneous representative in the selected spatial chart. -/
def incidenceGenericSpatial (p : Fin 4) : Fin 4 → IncidenceSpatialFunctionField K :=
  chartLift p (incidenceGenericSpatialAffine K)

@[simp] theorem incidenceGenericSpatial_pivot (p : Fin 4) :
    incidenceGenericSpatial (K := K) p p = 1 := by simp [incidenceGenericSpatial]

@[simp] theorem incidenceGenericSpatial_succAbove (p : Fin 4) (i : Fin 3) :
    incidenceGenericSpatial (K := K) p (p.succAbove i) =
      algebraMap (MvPolynomial (Fin 3) K) (IncidenceSpatialFunctionField K) (X i) := by
  simp [incidenceGenericSpatial, incidenceGenericSpatialAffine]

/-- Evaluation of an actual homogeneous polynomial at the generic chart
point is exactly the embedding of its dehomogenization. -/
theorem incidenceGenericSpatial_aeval (p : Fin 4) (F : MvPolynomial (Fin 4) K) :
    aeval (incidenceGenericSpatial (K := K) p) F =
      algebraMap (MvPolynomial (Fin 3) K) (IncidenceSpatialFunctionField K)
        (dehomogenizeAt p F) := by
  have hm : aeval (incidenceGenericSpatial (K := K) p) =
      (IsScalarTower.toAlgHom K (MvPolynomial (Fin 3) K)
        (IncidenceSpatialFunctionField K)).comp (dehomogenizeAt p) := by
    ext i
    obtain rfl | ⟨j, rfl⟩ := Fin.eq_self_or_eq_succAbove p i
    · simp
    · simp
  exact AlgHom.congr_fun hm F

/-- The pullback parameter coordinate is the image of the corresponding
universal incidence unknown under the already proved elimination map. -/
theorem incidenceParameterRatios_eq_universal
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) (i : Fin 2) :
    incidenceParameterRatios M k p h i =
      localizedIncidenceToFractionField (segreChartRow (netLinearRow M) k p)
        (segreChartRow (netQuadraticRow M) k p) h (Ideal.Quotient.mk _ (X i)) := by
  change minorLocalizationToFractionField _ _ h
    (localizedIncidenceAlgEquiv _ _
      (segreIncidenceMinorLocalizationAlgEquiv M k p
        (incidenceParameterChartMap M k p (Ideal.Quotient.mk _ (X (k.succAbove i)))))) = _
  rw [incidenceParameterChartMap_coordinate,
    incidenceParameterCoordinate_under_incidenceEquiv]
  rfl

/-- At the actual generic spatial point, the actual pulled-back parameter
ratios satisfy both incidence equations. -/
theorem incidenceGenericPoint_isIncident
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    IsIncident
      (mapRow (algebraMap (MvPolynomial (Fin 3) K) (IncidenceSpatialFunctionField K))
        (segreChartRow (netLinearRow M) k p))
      (mapRow (algebraMap (MvPolynomial (Fin 3) K) (IncidenceSpatialFunctionField K))
        (segreChartRow (netQuadraticRow M) k p))
      ⟨incidenceParameterRatios M k p h 0, incidenceParameterRatios M k p h 1, 1⟩ := by
  let a := segreChartRow (netLinearRow M) k p
  let b := segreChartRow (netQuadraticRow M) k p
  let f := localizedIncidenceToFractionField a b h
  have hc (r : MvPolynomial (Fin 3) K) :
      f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) r) =
        algebraMap (MvPolynomial (Fin 3) K) (IncidenceSpatialFunctionField K) r :=
    localizedIncidenceToFractionField_algebraMap a b h r
  have hh := affineIncidence_universal_isIncident (localizedRow a b a) (localizedRow a b b)
  have hs (i : Fin 2) : f (Ideal.Quotient.mk _ (X i)) =
      incidenceParameterRatios M k p h i := (incidenceParameterRatios_eq_universal M k p h i).symm
  constructor
  · have hh' := congrArg f hh.1
    simp only [dot, mapRow, localizedRow, map_add, map_mul, map_one, map_zero] at hh'
    change f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) a.x) *
      f (Ideal.Quotient.mk _ (X 0)) +
      f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) a.y) *
      f (Ideal.Quotient.mk _ (X 1)) +
      f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) a.z) * 1 = 0 at hh'
    simpa only [hc, hs, dot, mapRow] using hh'
  · have hh' := congrArg f hh.2
    simp only [dot, mapRow, localizedRow, map_add, map_mul, map_one, map_zero] at hh'
    change f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) b.x) *
      f (Ideal.Quotient.mk _ (X 0)) +
      f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) b.y) *
      f (Ideal.Quotient.mk _ (X 1)) +
      f (algebraMap (MvPolynomial (Fin 3) K) (LocalizedIncidenceAlgebra a b) b.z) * 1 = 0 at hh'
    simpa only [hc, hs, dot, mapRow] using hh'

/-- The actual normalized generic pair satisfies the global linear
incidence equation, with parameters in their generated subfield. -/
theorem incidenceGenericPoint_linear_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (∑ i : Fin 3,
      algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
        (incidenceGenericParameter M k p h i) *
      aeval (incidenceGenericSpatial (K := K) p) (netLinearRow M i)) = 0 := by
  have hh := (incidenceGenericPoint_isIncident M k p h).1
  rw [Fin.sum_univ_succAbove _ k]
  simp only [incidenceGenericParameter_pivot, map_one, one_mul, Fin.sum_univ_two,
    incidenceGenericParameter_succAbove, incidenceGenericSpatial_aeval]
  simp only [dot, mapRow, segreChartRow, mul_one] at hh
  convert hh using 1
  ring

/-- The same actual normalized generic pair satisfies the global
quadratic incidence equation. -/
theorem incidenceGenericPoint_quadratic_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (∑ i : Fin 3,
      algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
        (incidenceGenericParameter M k p h i) *
      aeval (incidenceGenericSpatial (K := K) p) (netQuadraticRow M i)) = 0 := by
  have hh := (incidenceGenericPoint_isIncident M k p h).2
  rw [Fin.sum_univ_succAbove _ k]
  simp only [incidenceGenericParameter_pivot, map_one, one_mul, Fin.sum_univ_two,
    incidenceGenericParameter_succAbove, incidenceGenericSpatial_aeval]
  simp only [dot, mapRow, segreChartRow, mul_one] at hh
  convert hh using 1
  ring

/-- The two nonpivot parameters generate the actual normalized parameter
chart algebra, by the explicit dehomogenization substitution. -/
def incidenceParameterPolynomialChartMap (k : Fin 3) :
    MvPolynomial (Fin 2) K →ₐ[K] ProjectiveCoordinateQuotient (K := K) k :=
  aeval (fun i => Ideal.Quotient.mk _ (X (k.succAbove i)))

@[simp] theorem incidenceParameterPolynomialChartMap_X (k : Fin 3) (i : Fin 2) :
    incidenceParameterPolynomialChartMap (K := K) k (X i) =
      Ideal.Quotient.mk _ (X (k.succAbove i)) := by simp [incidenceParameterPolynomialChartMap]

/-- Dehomogenizing and then restoring the retained coordinates is exactly
the quotient map imposing the actual relation `T_k = 1`. -/
theorem incidenceParameterPolynomialChartMap_dehomogenize (k : Fin 3)
    (F : MvPolynomial (Fin 3) K) :
    incidenceParameterPolynomialChartMap (K := K) k (dehomogenizeAt k F) =
      Ideal.Quotient.mk _ F := by
  have hm : (incidenceParameterPolynomialChartMap (K := K) k).comp (dehomogenizeAt k) =
      Ideal.Quotient.mkₐ K (projectiveCoordinateIdeal (K := K) k) := by
    ext i
    obtain rfl | ⟨j, rfl⟩ := Fin.eq_self_or_eq_succAbove k i
    · simp
    · simp
  exact AlgHom.congr_fun hm F

theorem incidenceParameterPolynomialChartMap_surjective (k : Fin 3) :
    Function.Surjective (incidenceParameterPolynomialChartMap (K := K) k) := by
  intro z
  obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨dehomogenizeAt k F, incidenceParameterPolynomialChartMap_dehomogenize k F⟩

/-- The actual function-field parameter pullback agrees with polynomial
evaluation at the actual ratios on every retained-parameter polynomial. -/
theorem incidenceParameterFunctionFieldMap_comp_polynomial
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (incidenceParameterFunctionFieldMap M k p h).comp
      (incidenceParameterPolynomialChartMap k) =
        aeval (incidenceParameterRatios M k p h) := by
  ext i
  simp only [AlgHom.comp_apply, incidenceParameterPolynomialChartMap_X, aeval_X]
  rfl

/-- Algebraic independence of the actual two ratios proves injectivity
of the actual parameter-chart pullback. This connects transcendence-degree
arguments directly to the existing geometric dominance criterion. -/
theorem incidenceParameterChartMap_injective_of_algebraicIndependent
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0)
    (hs : AlgebraicIndependent K (incidenceParameterRatios M k p h)) :
    Function.Injective (incidenceParameterChartMap M k p) := by
  have hi : Function.Injective (incidenceParameterFunctionFieldMap M k p h) := by
    intro u v huv
    obtain ⟨F, rfl⟩ := incidenceParameterPolynomialChartMap_surjective k u
    obtain ⟨G, rfl⟩ := incidenceParameterPolynomialChartMap_surjective k v
    apply congrArg (incidenceParameterPolynomialChartMap (K := K) k)
    apply (algebraicIndependent_iff_injective_aeval.mp hs)
    change (incidenceParameterFunctionFieldMap M k p h).comp
      (incidenceParameterPolynomialChartMap k) F =
      (incidenceParameterFunctionFieldMap M k p h).comp
      (incidenceParameterPolynomialChartMap k) G at huv
    simpa only [incidenceParameterFunctionFieldMap_comp_polynomial] using huv
  intro u v huv
  apply hi
  change minorLocalizationToFractionField _ _ h
      (incidenceMinorEliminationAlgEquiv M k p (incidenceParameterChartMap M k p u)) =
    minorLocalizationToFractionField _ _ h
      (incidenceMinorEliminationAlgEquiv M k p (incidenceParameterChartMap M k p v))
  rw [huv]

end EvenQuinticConic.Incidence
