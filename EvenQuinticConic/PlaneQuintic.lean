import EvenQuinticConic.GradedRestriction
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Topology
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.Topology.Irreducible

/-!
# A plane hypersurface's actual projective generic point and cone model

We construct the homogeneous prime `(F)` as an actual point of the projective
spectrum of `K[X₀,X₁,X₂]`. Its closure is the projective zero locus of `F`,
and that locus has vanishing ideal `(F)`.

Separately, the cone quotient `K[X₀,X₁,X₂]/(F)` and its fraction field give
actual coefficient maps whose low-degree injectivity follows from the degree
of `F`. The cone's fraction field is not identified with the function field
of the projective curve. No twisting sheaf or global-section calculation is
asserted here.
-/

noncomputable section

namespace EvenQuinticConic

open MvPolynomial

variable {K : Type*} [Field K]

/-- The actual homogeneous coordinate polynomial ring of the projective plane. -/
abbrev PlanePolynomial (K : Type*) [Field K] := MvPolynomial (Fin 3) K

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The principal homogeneous ideal generated by a homogeneous plane form. -/
def planeHomogeneousPrincipal (F : PlanePolynomial K) (e : ℕ)
    (hF : F.IsHomogeneous e) : HomogeneousIdeal (homogeneousSubmodule (Fin 3) K) :=
  ⟨Ideal.span {F}, Ideal.homogeneous_span _ _ (by
    intro P hP
    have hPF : P = F := Set.mem_singleton_iff.mp hP
    subst P
    exact ⟨e, hF⟩)⟩

/-- Irreducibility of a plane polynomial supplies the prime-ideal hypothesis
used by both the projective point and the actual cone domain. -/
theorem plane_principal_isPrime_of_irreducible (F : PlanePolynomial K)
    (hF : Irreducible F) : (Ideal.span {F}).IsPrime :=
  (Ideal.span_singleton_prime hF.ne_zero).mpr
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp hF)

/-- Every coordinate is outside a principal ideal whose generator has degree
greater than one. -/
theorem plane_coordinate_not_mem_principal (F : PlanePolynomial K)
    (hFdeg : 1 < F.totalDegree) (i : Fin 3) :
    X i ∉ Ideal.span {F} := by
  intro hi
  have hF0 : F ≠ 0 := by
    intro h
    simp [h] at hFdeg
  have hz := eq_zero_of_dvd_of_totalDegree_lt F (X i) hF0
    (Ideal.mem_span_singleton.mp hi) (by simpa using hFdeg)
  exact X_ne_zero i hz

/-- A homogeneous irreducible hypersurface's ideal is an actual projective
point; relevance is proved using a coordinate of degree one. -/
def planeHypersurfaceGenericPoint (F : PlanePolynomial K) (e : ℕ)
    (hF : F.IsHomogeneous e) (hFdeg : 1 < F.totalDegree)
    (hprime : (Ideal.span {F}).IsPrime) :
    ProjectiveSpectrum (homogeneousSubmodule (Fin 3) K) where
  asHomogeneousIdeal := planeHomogeneousPrincipal F e hF
  isPrime := hprime
  not_irrelevant_le := by
    intro hle
    apply plane_coordinate_not_mem_principal F hFdeg 0
    apply hle
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    exact DirectSum.decompose_of_mem_ne (homogeneousSubmodule (Fin 3) K)
      (isHomogeneous_X K 0) (by decide : (1 : ℕ) ≠ 0)

/-- The actual projective hypersurface as a closed set of `Proj K[X₀,X₁,X₂]`. -/
def planeHypersurfaceLocus (F : PlanePolynomial K) :
    Set (ProjectiveSpectrum (homogeneousSubmodule (Fin 3) K)) :=
  ProjectiveSpectrum.zeroLocus (homogeneousSubmodule (Fin 3) K) {F}

/-- The point `(F)` specializes to precisely the projective hypersurface. -/
theorem closure_planeHypersurfaceGenericPoint (F : PlanePolynomial K) (e : ℕ)
    (hF : F.IsHomogeneous e) (hFdeg : 1 < F.totalDegree)
    (hprime : (Ideal.span {F}).IsPrime) :
    closure ({planeHypersurfaceGenericPoint F e hF hFdeg hprime} :
      Set (ProjectiveSpectrum (homogeneousSubmodule (Fin 3) K))) =
      planeHypersurfaceLocus F := by
  rw [← ProjectiveSpectrum.zeroLocus_vanishingIdeal_eq_closure,
    ProjectiveSpectrum.vanishingIdeal_singleton]
  change ProjectiveSpectrum.zeroLocus (homogeneousSubmodule (Fin 3) K)
    (Ideal.span {F} : Set (PlanePolynomial K)) = _
  exact ProjectiveSpectrum.zeroLocus_span _ _

/-- The projective vanishing ideal is genuinely computed, using the actual
generic point. No abstract vanishing-ideal hypothesis is introduced. -/
theorem vanishingIdeal_planeHypersurfaceLocus (F : PlanePolynomial K) (e : ℕ)
    (hF : F.IsHomogeneous e) (hFdeg : 1 < F.totalDegree)
    (hprime : (Ideal.span {F}).IsPrime) :
    (ProjectiveSpectrum.vanishingIdeal (planeHypersurfaceLocus F)).toIdeal =
      Ideal.span {F} := by
  rw [← closure_planeHypersurfaceGenericPoint F e hF hFdeg hprime,
    ProjectiveSpectrum.vanishingIdeal_closure,
    ProjectiveSpectrum.vanishingIdeal_singleton]
  rfl

/-- The constructed projective zero locus is irreducible, because it is the
closure of the actual homogeneous prime `(F)`. -/
theorem planeHypersurfaceLocus_isIrreducible (F : PlanePolynomial K) (e : ℕ)
    (hF : F.IsHomogeneous e) (hFdeg : 1 < F.totalDegree)
    (hprime : (Ideal.span {F}).IsPrime) :
    IsIrreducible (planeHypersurfaceLocus F) := by
  rw [← closure_planeHypersurfaceGenericPoint F e hF hFdeg hprime]
  exact isIrreducible_singleton.closure

/-- The actual affine-cone coordinate ring. -/
abbrev PlaneConeQuotient (F : PlanePolynomial K) :=
  PlanePolynomial K ⧸ Ideal.span ({F} : Set (PlanePolynomial K))

/-- The canonical restriction into the fraction field of the affine cone.
This codomain is not named or assumed to be the curve's function field. -/
def planeConeGenericEval (F : PlanePolynomial K) [(Ideal.span {F}).IsPrime] :
    PlanePolynomial K →ₐ[K] FractionRing (PlaneConeQuotient F) :=
  (IsScalarTower.toAlgHom K (PlaneConeQuotient F)
    (FractionRing (PlaneConeQuotient F))).comp (Ideal.Quotient.mkₐ K (Ideal.span {F}))

/-- Images of the three homogeneous coordinates in the cone's fraction field. -/
def planeConeCoordinates (F : PlanePolynomial K) [(Ideal.span {F}).IsPrime] :
    Fin 3 → FractionRing (PlaneConeQuotient F) :=
  fun i => planeConeGenericEval F (X i)

/-- Evaluation at these actual coordinates is the canonical quotient map
followed by the injective fraction-field map. -/
theorem aeval_planeConeCoordinates (F : PlanePolynomial K) [(Ideal.span {F}).IsPrime] :
    aeval (planeConeCoordinates F) = planeConeGenericEval F := by
  ext i
  simp [planeConeCoordinates]

/-- Vanishing in the cone's fraction field is exactly membership in `(F)`. -/
theorem planeConeGenericEval_eq_zero_iff (F P : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] :
    planeConeGenericEval F P = 0 ↔ P ∈ Ideal.span {F} := by
  change algebraMap (PlaneConeQuotient F) (FractionRing (PlaneConeQuotient F))
    (Ideal.Quotient.mk (Ideal.span {F}) P) = 0 ↔ _
  rw [IsFractionRing.to_map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]

/-- The actual cone model proves the low-degree injectivity required in the
conic argument. No kernel assumption is required. -/
theorem planeConeCoordinates_injective_below_degree (F P : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (hF : F ≠ 0)
    (hdeg : P.totalDegree < F.totalDegree) (hP : aeval (planeConeCoordinates F) P = 0) :
    P = 0 := by
  rw [aeval_planeConeCoordinates, planeConeGenericEval_eq_zero_iff] at hP
  exact eq_zero_of_dvd_of_totalDegree_lt F P hF (Ideal.mem_span_singleton.mp hP) hdeg

/-- In particular, a defining quintic supplies verified injectivity in each
homogeneous degree below five, including degrees one, two, and four. -/
theorem planeQuintic_homogeneous_restriction_injective (F : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (hFdeg : F.totalDegree = 5)
    (d : ℕ) (hd : d < 5) (P : PlanePolynomial K) (hP : P.IsHomogeneous d)
    (hzero : aeval (planeConeCoordinates F) P = 0) : P = 0 := by
  apply planeConeCoordinates_injective_below_degree F P _ _ hzero
  · intro h
    simp [h] at hFdeg
  · have := hP.totalDegree_le
    omega

/-- Every projective chart denominator is nonzero in the cone's fraction
field for a hypersurface whose degree exceeds one. -/
theorem planeConeCoordinates_ne_zero (F : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (hFdeg : 1 < F.totalDegree) (i : Fin 3) :
    planeConeCoordinates F i ≠ 0 := by
  intro hi
  exact plane_coordinate_not_mem_principal F hFdeg i
    ((planeConeGenericEval_eq_zero_iff F (X i)).mp hi)

/-- Actual normalized projective coordinate ratios, still valued in the
cone's fraction field. They are not declared to be the curve's stalk. -/
def planeChartCoordinates (F : PlanePolynomial K) [(Ideal.span {F}).IsPrime]
    (j : Fin 3) : Fin 3 → FractionRing (PlaneConeQuotient F) :=
  fun i => planeConeCoordinates F i / planeConeCoordinates F j

/-- Normalizing the coordinates records the standard homogeneous denominator. -/
theorem aeval_planeChartCoordinates_of_isHomogeneous (F P : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (j : Fin 3) (d : ℕ) (hP : P.IsHomogeneous d) :
    aeval (planeChartCoordinates F j) P =
      planeConeGenericEval F P / (planeConeCoordinates F j) ^ d := by
  change eval₂ (algebraMap K (FractionRing (PlaneConeQuotient F)))
    (fun i => planeConeCoordinates F i / planeConeCoordinates F j) P = _
  simp only [div_eq_mul_inv]
  rw [homogeneous_eval₂_scale _ _ _ P d hP]
  change aeval (planeConeCoordinates F) P * ((planeConeCoordinates F j)⁻¹) ^ d = _
  rw [aeval_planeConeCoordinates, inv_pow]

/-- Verified degree-below-five injectivity for normalized chart coordinates.
The full ungraded evaluation is not injective: the chosen coordinate is one.
-/
theorem planeQuintic_chart_homogeneous_restriction_injective (F : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (hFdeg : F.totalDegree = 5)
    (j : Fin 3) (d : ℕ) (hd : d < 5) (P : PlanePolynomial K)
    (hP : P.IsHomogeneous d) (hzero : aeval (planeChartCoordinates F j) P = 0) :
    P = 0 := by
  rw [aeval_planeChartCoordinates_of_isHomogeneous F P j d hP] at hzero
  have hden : (planeConeCoordinates F j) ^ d ≠ 0 :=
    pow_ne_zero d (planeConeCoordinates_ne_zero F (by omega) j)
  have hnum : planeConeGenericEval F P = 0 := (div_eq_zero_iff.mp hzero).resolve_right hden
  apply planeQuintic_homogeneous_restriction_injective F hFdeg d hd P hP
  rw [aeval_planeConeCoordinates]
  exact hnum

/-- The exact quartic-injectivity input to the conic factorization theorem,
now proved from an actual quintic defining equation and quotient domain. -/
theorem planeQuintic_chart_quartic_injective (F : PlanePolynomial K)
    [(Ideal.span {F}).IsPrime] (hFdeg : F.totalDegree = 5) (j : Fin 3) :
    ∀ P : PlanePolynomial K, P.IsHomogeneous 4 →
      aeval (planeChartCoordinates F j) P = 0 → P = 0 :=
  planeQuintic_chart_homogeneous_restriction_injective F hFdeg j 4 (by decide)

end EvenQuinticConic
