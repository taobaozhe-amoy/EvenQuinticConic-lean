import EvenQuinticConic.IncidenceParameterFunctionField
import EvenQuinticConic.IncidenceTranscendence
import EvenQuinticConic.IncidenceGeometricFibers
import EvenQuinticConic.IncidenceLinearElimination

/-!
# Dominance of the actual incidence-chart parameter projection

The parameter field below is the field generated by the actual pullback
ratios. All incidence equations used in the transcendence argument come
from the actual quotient-coordinate maps.
-/

noncomputable section
set_option maxRecDepth 4096
namespace EvenQuinticConic.Incidence
open Matrix MvPolynomial AlgebraicGeometry

universe u

variable {K : Type*} [Field K]

/-- The actual member of the net at the actual generic parameter. -/
def incidenceGenericMatrix
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    Matrix (Fin 5) (Fin 5) (incidenceParameterSubfield M k p h) :=
  (linearMatrixNet (fun i => (M i).map (algebraMap K (incidenceParameterSubfield M k p h)))).map
    (eval (incidenceGenericParameter M k p h))

theorem incidenceGenericMatrix_entry
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) (r c : Fin 5) :
    incidenceGenericMatrix M k p h r c =
      ∑ i, incidenceGenericParameter M k p h i *
        algebraMap K (incidenceParameterSubfield M k p h) (M i r c) := by
  simp [incidenceGenericMatrix, linearMatrixNet, Matrix.map_apply, mul_comm]

theorem incidenceGenericMatrix_isSymm
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (incidenceGenericMatrix M k p h).IsSymm := by
  apply linearMatrixNet_eval_isSymm
  intro i
  apply Matrix.IsSymm.ext
  intro r c
  simp only [Matrix.map_apply]
  rw [(hM i).apply]

theorem incidenceGenericMatrix_zero_zero
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hbase : ∀ i, M i 0 0 = 0)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    incidenceGenericMatrix M k p h 0 0 = 0 := by
  simp [incidenceGenericMatrix_entry, hbase]

/-- The actual generic spatial representative lies on the polar hyperplane
of the actual generic member. -/
theorem incidenceGenericMatrix_polar_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (∑ j : Fin 4,
      algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
        (incidenceGenericMatrix M k p h j.succ 0) *
      incidenceGenericSpatial (K := K) p j) = 0 := by
  have hh := incidenceGenericPoint_linear_equation M k p h
  simp only [netLinearRow, coefficientLinearPolynomial, map_sum, map_mul, aeval_C,
    aeval_X, Finset.mul_sum] at hh
  simp only [incidenceGenericMatrix_entry, map_sum, map_mul,
    ← IsScalarTower.algebraMap_apply K (incidenceParameterSubfield M k p h)
      (IncidenceSpatialFunctionField K), Finset.sum_mul]
  rw [Finset.sum_comm]
  convert hh using 1
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The same representative lies on the spatial quadratic equation of
that actual member. -/
theorem incidenceGenericMatrix_quadratic_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    aeval (incidenceGenericSpatial (K := K) p)
      (matrixQuadraticPolynomial (fun i j : Fin 4 =>
        incidenceGenericMatrix M k p h i.succ j.succ)) = 0 := by
  have hh := incidenceGenericPoint_quadratic_equation M k p h
  simp only [netQuadraticRow, matrixQuadraticPolynomial, map_sum, map_mul, aeval_C,
    aeval_X, Finset.mul_sum] at hh
  simp only [matrixQuadraticPolynomial, map_sum, map_mul, aeval_C, aeval_X,
    incidenceGenericMatrix_entry, map_sum, map_mul,
    ← IsScalarTower.algebraMap_apply K (incidenceParameterSubfield M k p h)
      (IncidenceSpatialFunctionField K), Finset.sum_mul]
  conv_lhs =>
    arg 2
    ext i
    rw [Finset.sum_comm]
  rw [Finset.sum_comm]
  convert hh using 1
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro l _
  ring

/-- In the selected spatial affine chart the actual linear relation has
its displayed three coefficients and constant term. -/
theorem incidenceGenericMatrix_affine_linear_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    (∑ j : Fin 3,
      algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
        (incidenceGenericMatrix M k p h (p.succAbove j).succ 0) *
      incidenceGenericSpatialAffine K j) +
      algebraMap (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K)
        (incidenceGenericMatrix M k p h p.succ 0) = 0 := by
  have hh := incidenceGenericMatrix_polar_equation M k p h
  rw [Fin.sum_univ_succAbove _ p] at hh
  simpa [incidenceGenericSpatialAffine, add_comm] using hh

/-- Dehomogenizing the actual spatial quadratic still vanishes at the
actual three affine coordinates in the function field. -/
theorem incidenceGenericMatrix_affine_quadratic_equation
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    aeval (incidenceGenericSpatialAffine K)
      (dehomogenizeAt p (matrixQuadraticPolynomial (fun i j : Fin 4 =>
        incidenceGenericMatrix M k p h i.succ j.succ))) = 0 := by
  have hm : (aeval (incidenceGenericSpatialAffine K)).comp
      (dehomogenizeAt (K := incidenceParameterSubfield M k p h) p) =
      aeval (incidenceGenericSpatial (K := K) p) := by
    ext i
    obtain rfl | ⟨j, rfl⟩ := Fin.eq_self_or_eq_succAbove p i
    · simp
    · simp [incidenceGenericSpatialAffine]
  change ((aeval (incidenceGenericSpatialAffine K)).comp
    (dehomogenizeAt p)) _ = 0
  rw [hm]
  exact incidenceGenericMatrix_quadratic_equation M k p h

/-- A genuine affine coefficient of the actual polar equation is nonzero.
The geometric Jacobian certificate rules out a vanishing polar vector, and
the actual incidence equation rules out a nonzero constant equation. -/
theorem incidenceGenericMatrix_exists_affine_coefficient_ne_zero
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
    (hbase : ∀ i, M i 0 0 = 0)
    (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    ∃ q : Fin 3, incidenceGenericMatrix M k p h (p.succAbove q).succ 0 ≠ 0 := by
  let F : Type _ := incidenceParameterSubfield M k p h
  letI : Field F := inferInstanceAs (Field (incidenceParameterSubfield M k p h))
  letI : Algebra K F := inferInstanceAs (Algebra K (incidenceParameterSubfield M k p h))
  let t : Fin 3 → F := incidenceGenericParameter M k p h
  have hsym (i : Fin 3) : ((M i).map (algebraMap K F)).IsSymm := by
    apply Matrix.IsSymm.ext
    intro r c
    simp only [Matrix.map_apply]
    rw [(hM i).apply]
  have ht : t ≠ 0 := by
    intro hz
    have hk := congrFun hz k
    simp [t] at hk
  have hlinear := incidenceGenericMatrix_affine_linear_equation M k p h
  simp only [incidenceGenericMatrix_entry] at hlinear
  have hh := linearMatrixNet_exists_affine_polar_coefficient_ne_zero
    (fun i => (M i).map (algebraMap K F)) hsym
    (fun i => by simp only [Matrix.map_apply, hbase i, map_zero])
    (linearMatrixNet_jacobian_over_field M hCert (algebraMap K F)) t ht
    (algebraMap F (IncidenceSpatialFunctionField K)) p (incidenceGenericSpatialAffine K)
    hlinear
  simpa only [incidenceGenericMatrix_entry, Matrix.map_apply, t] using hh

/-- The generic matrix incidence argument eliminates the actual linear
and quadratic equations. The coefficient, adjugate, and equation hypotheses
are all discharged from the concrete matrix net in the theorem below. -/
theorem parameters_algebraicIndependent_of_symmetric_incidence
    (K F L : Type u) [Field K] [Field F] [Field L] [Infinite F]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    (h2 : (2 : F) ≠ 0)
    (x : Fin 3 → L) (hx : AlgebraicIndependent K x)
    (hxgen : IntermediateField.adjoin K (Set.range x) = ⊤)
    (t : Fin 2 → F) (htgen : IntermediateField.adjoin K (Set.range t) = ⊤)
    (A : Matrix (Fin 5) (Fin 5) F) (hA : A.IsSymm) (hbase : A 0 0 = 0)
    (hadj : A.adjugate ≠ 0) (p : Fin 4) (q : Fin 3)
    (ha : A (p.succAbove q).succ 0 ≠ 0)
    (hlinear : (∑ j : Fin 3, algebraMap F L (A (p.succAbove j).succ 0) * x j) +
      algebraMap F L (A p.succ 0) = 0)
    (hquad : aeval x (dehomogenizeAt p
      (matrixQuadraticPolynomial (A.submatrix Fin.succ Fin.succ))) = 0) :
    AlgebraicIndependent K t := by
  let a : Fin 3 → F := fun j => A (p.succAbove j).succ 0
  let c : F := A p.succ 0
  let Q : MvPolynomial (Fin 3) F := dehomogenizeAt p
    (matrixQuadraticPolynomial (A.submatrix Fin.succ Fin.succ))
  let P : MvPolynomial (Fin 2) F := affineEliminationSubstitution a c q Q
  have hP : P ≠ 0 :=
    affineElimination_incidenceQuadratic_ne_zero h2 A hA hbase hadj p q ha
  have hrel : aeval (fun j : Fin 2 => x (q.succAbove j)) P = 0 :=
    aeval_affineEliminationSubstitution_eq_zero a c q ha x hlinear Q hquad
  exact parameters_algebraicIndependent_of_linear_elimination K F L x hx hxgen
    t htgen a c q ha hlinear P hP hrel

/-- The actual two parameter ratios are algebraically independent. The
proof derives the needed nonzero linear coefficient and nonzero residual
quadratic from the geometric Jacobian certificate, rather than assuming
injectivity or dominance of the parameter map. -/
theorem incidenceParameterRatios_algebraicIndependent [Infinite K]
    (h2 : (2 : K) ≠ 0)
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
    (hbase : ∀ i, M i 0 0 = 0)
    (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    AlgebraicIndependent K (incidenceParameterRatios M k p h) := by
  let F : Type _ := incidenceParameterSubfield M k p h
  letI : Field F := inferInstanceAs (Field (incidenceParameterSubfield M k p h))
  letI : Algebra K F := inferInstanceAs (Algebra K (incidenceParameterSubfield M k p h))
  let L : Type _ := IncidenceSpatialFunctionField K
  letI : Field L := inferInstanceAs (Field (IncidenceSpatialFunctionField K))
  letI : Algebra K L := inferInstanceAs (Algebra K (IncidenceSpatialFunctionField K))
  letI : Algebra F L := inferInstanceAs
    (Algebra (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K))
  letI : IsScalarTower K F L := inferInstanceAs
    (IsScalarTower K (incidenceParameterSubfield M k p h) (IncidenceSpatialFunctionField K))
  let A : Matrix (Fin 5) (Fin 5) F := incidenceGenericMatrix M k p h
  let x : Fin 3 → L := incidenceGenericSpatialAffine K
  let t : Fin 3 → F := incidenceGenericParameter M k p h
  let u : Fin 2 → F := fun i => ⟨incidenceParameterRatios M k p h i,
    IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩
  letI : Infinite F := Infinite.of_injective (algebraMap K F) (algebraMap K F).injective
  have h2F : (2 : F) ≠ 0 := by
    simpa only [map_ofNat] using (map_ne_zero (algebraMap K F)).mpr h2
  have ht : t ≠ 0 := by
    intro ht
    have hk := congrFun ht k
    simp [t] at hk
  have hadj : A.adjugate ≠ 0 :=
    linearMatrixNet_adjugate_ne_zero_over_field M hCert (algebraMap K F) t ht
  obtain ⟨q, hq⟩ := incidenceGenericMatrix_exists_affine_coefficient_ne_zero
    M hM hbase hCert k p h
  have hu : AlgebraicIndependent K u :=
    parameters_algebraicIndependent_of_symmetric_incidence K F L h2F x
      (rationalThreeCoordinates_algebraicIndependent K)
      (rationalThreeCoordinates_fieldAdjoin_eq_top K) u
      (fieldAdjoin_canonical_generators_eq_top K L (incidenceParameterRatios M k p h))
      A (incidenceGenericMatrix_isSymm M hM k p h)
      (incidenceGenericMatrix_zero_zero M hbase k p h) hadj p q hq
      (incidenceGenericMatrix_affine_linear_equation M k p h)
      (incidenceGenericMatrix_affine_quadratic_equation M k p h)
  exact (canonicalParameters_algebraicIndependent_iff K L
    (incidenceParameterRatios M k p h)).mp hu

/-- Injectivity of the actual chart pullback follows from the actual
geometric matrix-net hypotheses. -/
theorem incidenceParameterChartMap_injective_of_geometricJacobian [Infinite K]
    (h2 : (2 : K) ≠ 0)
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
    (hbase : ∀ i, M i 0 0 = 0)
    (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    Function.Injective (incidenceParameterChartMap M k p) :=
  incidenceParameterChartMap_injective_of_algebraicIndependent M k p h
    (incidenceParameterRatios_algebraicIndependent h2 M hM hbase hCert k p h)

/-- The actual morphism from the specified global incidence open dominates
the parameter projective plane. -/
theorem globalIncidenceMinorParameterProjection_isDominant_of_geometricJacobian [Infinite K]
    (h2 : (2 : K) ≠ 0)
    (M : Fin 3 → Matrix (Fin 5) (Fin 5) K) (hM : ∀ i, (M i).IsSymm)
    (hbase : ∀ i, M i 0 0 = 0)
    (hCert : ProjectiveJacobianCertificate (linearMatrixNet M).det)
    (k : Fin 3) (p : Fin 4)
    (h : (cross (segreChartRow (netLinearRow M) k p)
      (segreChartRow (netQuadraticRow M) k p)).z ≠ 0) :
    IsDominant (globalIncidenceMinorParameterProjection M k p h) :=
  globalIncidenceMinorParameterProjection_isDominant_of_injective M k p h
    (incidenceParameterChartMap_injective_of_geometricJacobian h2 M hM hbase hCert k p h)

end EvenQuinticConic.Incidence
